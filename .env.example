# StockSense Supabase Configuration
# Copy this file to .env.local and fill in your Supabase Project settings (Settings > API)
# The app works without these — it uses built-in demo data by default.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
